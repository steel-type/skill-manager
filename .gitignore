# Skills deployed into this repo by the app during dev/testing — these
# are the agent-specific deployment trees (.claude, .codex, .gemini,
# .continue, .cursor, .cline). Source of truth lives in ~/.claude/skills/.
.claude/skills/
.codex/skills/
.gemini/skills/
.continue/skills/
.cursor/rules/
.cline/skills/

# Agent tooling scratch — local-only worktrees and superpowers brainstorm
# state created by Claude Code during dev. Never part of the app.
.claude/worktrees/
.superpowers/
